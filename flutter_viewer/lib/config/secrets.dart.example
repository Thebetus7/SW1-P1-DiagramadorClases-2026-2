class AiConfig {
  /// Plantilla de configuración de secretos de IA para Flutter.
  /// Copia este archivo a `secrets.dart` e ingresa tu API Key de Gemini:
  /// cp lib/config/secrets.dart.example lib/config/secrets.dart
  static const String defaultGeminiApiKey = String.fromEnvironment(
    'GEMINI_API_KEY',
    defaultValue: 'TU_GEMINI_API_KEY_AQUI',
  );
}

